# Server Configuration
PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mycodu?retryWrites=true&w=majority

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
